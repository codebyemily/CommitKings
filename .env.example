# Supabase — copy to .env.local and fill in from:
# Dashboard → Project Settings → API (Legacy: Project URL + anon key; or API Keys → Publishable)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Use one of these (anon is the classic name; publishable is the newer key type):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only (never expose to the browser) — only for admin scripts / webhooks:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OneSignal Web Push — Dashboard → Settings → Keys & IDs → OneSignal App ID
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Server-only — same App ID as above (optional duplicate so API routes need no NEXT_PUBLIC_*)
# ONESIGNAL_APP_ID=

# Dashboard → Settings → Keys & IDs → REST API Key (required for DM push from webhook)
# ONESIGNAL_REST_API_KEY=

# Public site URL for notification click-through (e.g. https://your-app.vercel.app). Falls back to VERCEL_URL on Vercel.
# NEXT_PUBLIC_APP_URL=

# Random secret; Supabase Database Webhook must send header: x-webhook-secret: <this value>
# MESSAGE_WEBHOOK_SECRET=
